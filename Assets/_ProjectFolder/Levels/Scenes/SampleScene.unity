  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bc0a149ba49fb06448ef03ac74ec90f1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Tutorial
  dialogueTween: {fileID: 1742340703}
  cursorHandler: {fileID: 506108677}
  text: {fileID: 1007346571}
  charsPerSecond: 30
  onComplete:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 155041522}
        m_TargetAssemblyTypeName: NPC_Sequencer, Assembly-CSharp
        m_MethodName: LoadNextSoul
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
      - m_Target: {fileID: 825113035}
        m_TargetAssemblyTypeName: UnityEngine.Animator, UnityEngine
        m_MethodName: SetTrigger
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: Leave
          m_BoolArgument: 0
        m_CallState: 2
  messages:
  - "\xA1Bienvenido desafortunado!, Soy el Supay, el Dios que reina el infierno Inca,
    la pr\xF3xima vez que firmes t\xE9rminos y condiciones ser\xE1 mejor que leas
    la letra peque\xF1a"
  - "Dejando las formalidades... Tengo mucha hambre, tu labor ser\xE1 juzgar las
    almas de los peruanos que acaban de morir."
  - "Compara la hoja de vida de cada persona y decide a quien mandar al Hanan Pacha
    (Cielo), Uku Pacha (Infierno) y juzga sus pecados seg\xFAn la ley inca: Ama Sua
    (No seas ladr\xF3n), Ama Llulla (No seas mentiroso) y Ama Quella (No seas ocioso)"
  - "Lee bien la lista de acciones de cada persona, juzgas sus pecados y env\xEDalos
    a alg\xFAn lugar, consigue al menos 750 puntos de almas para mi, sino ser\xE1
    tu alma la que pague."
